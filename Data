""" create a function which takes the lenghts of a sides of a triangle and checks 
wether the lengths indeed represent the lengths of the sides of a triangle"""

def triangle(a,b,c):
    if((a+b>c) and (b + c>a) and (c+a>b)):
        print("It can form a triangle")
    else:
        print("It cannot form a triangle")

print(triangle(10,7,12))

print(triangle(1,7,12))
