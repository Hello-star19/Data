import numpy as np

sample_list = [1,2,3,4,5]
print((f"{type(sample_list)}\n"))

# convert a list to an array
numpy_array = np.array(sample_list)
print(f"{type(numpy_array)}\n")

# creating a numpy array of zeroes
zeroes_array = np.zeros(5)
print(f"\nzeros array: \n{zeroes_array}\n")

zeros = np.zeros((4,2,3),dtype=int)  # 4 blocks 2 rows and 3 columns 
print(f"\nzeros array: \n{zeros}\n")

ones_array = np.ones(5)
print(f"Ones array : \n{ones_array}\n")

ones = np.ones((5,3,3),dtype=int) # by default the data type is a float
print(f"Ones:\n{ones}\n")

# specifing the data type during instatiation
float_array = np.array([1,2,3,4,5],dtype="f")
print(f"float array: \n{float_array}\n")

twod_array = np.array([[1,2],[3,4]])
print("\ntwod array: ")
print(twod_array,"\n")

